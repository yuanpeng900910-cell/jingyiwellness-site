{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jingyiwellness-site",
  "main": "./worker-static.js",
  "compatibility_date": "2026-09-25",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "jingyiwellness.online",
      "custom_domain": true,
      "zone_id": "68e3f023db63e71e6c5f81d12ace90ed"
    },
    {
      "pattern": "preview.jingyiwellness.online",
      "custom_domain": true,
      "zone_id": "68e3f023db63e71e6c5f81d12ace90ed"
    }
  ],
  "vars": {
    "PUBLIC_SITE_ENABLED": "false"
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
